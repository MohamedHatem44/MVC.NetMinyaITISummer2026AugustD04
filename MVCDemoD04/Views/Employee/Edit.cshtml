@model EmployeeEditVM

<h1 style="color:green; text-align:center">
    Edit Employee
</h1>

<br />
<br />
<hr />

<form action="~/Employee/Edit" method="post">

    <div class="form-group mb-3">
        <label for="Id" class="form-label">Id</label>
        <input type="number" name="Id" class="form-control" id="Id" value="@Model.Id" readonly />
        @* <input type="number" name="Id" class="form-control" id="Id" value="@Model.Id" hidden /> *@
    </div>

    <div class="form-group mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" name="Name" class="form-control" id="Name" value="@Model.Name" />
    </div>

    <div class="form-group mb-3">
        <label for="Age" class="form-label">Age</label>
        <input type="number" name="Age" class="form-control" id="Age" value="@Model.Age" />
    </div>

    <div class="form-group mb-3">
        <label for="Salary" class="form-label">Salary</label>
        <input type="number" name="Salary" class="form-control" id="Salary" value="@Model.Salary" />
    </div>

    <div class="form-group mb-3">
        <label for="DepartmentId" class="form-label">Department</label>
        <select class="form-select" id="DepartmentId" name="DepartmentId" required>
            <option value="@Model.DepartmentId">@Model.DepartmentName</option>
            @foreach (var dept in Model.Departments!)
            {
                if(dept.Value != Model.DepartmentId.ToString())
                {
                    <option value="@dept.Value">@dept.Text</option>
                }
            }
        </select>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-outline-success" value="Save" />
        <a href="~/Employee/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>

</form>