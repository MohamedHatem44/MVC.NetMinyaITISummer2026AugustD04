@model MVCDemoD03.ViewModels.Department.DepartmentCreateVM

<h1 style="color:green; text-align:center">
    Create New Department
</h1>

<br />
<br />
<hr />

<form action="~/Department/Create" method="post">

    <div class="form-group mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" name="Name" class="form-control" id="Name" />
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-outline-success" value="Create Department" />
        <a href="~/Department/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>

</form>
