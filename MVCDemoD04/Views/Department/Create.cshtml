@model DepartmentCreateVM

<h1 style="color:green; text-align:center">
    Create New Department
</h1>

<br />
<br />
<hr />

<form action="~/Department/Create" method="post">
    @* Search  *@
    @* @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Search..." }) *@


    <div class="form-group mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" name="Name" class="form-control" id="Name" />


        @Html.TextBox("Name")
        @Html.Label("Terms", "I accept the terms and conditions")
        @Html.CheckBox("Terms")
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(d => d.Name, new { @class = "form-label" })
        @Html.TextBoxFor(e => e.Name, new
        {
            @class = "form-control",
                required = "required",
                placeholder = "Enter Department Name"
                })

        @Html.ValidationMessageFor(d => d.Name, "", new { @class = "text-danger" })
        @Html.EditorFor(d => d.Name)
        @* @Html.EditorFor(d => d.Age) *@
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-outline-success" value="Create Department" />
        @* <a href="~/Department/Index" class="btn btn-outline-secondary">Cancel</a> *@
        @Html.ActionLink("Cancel", "Index", "Department", null, new { @class = "btn btn-outline-secondary" })
    </div>

</form>



@* HTML Helper *@
