        {
            @class = "form-control",
        required = "required",
        placeholder = "Enter Department Name"
        })

    @Html.ValidationMessageFor(d => d.Name, "", new { @class = "text-danger" })
    @Html.EditorFor(d => d.Name)
    @* @Html.EditorFor(d => d.Age) *@
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-outline-success" value="Create Department" />
        @* <a href="~/Department/Index" class="btn btn-outline-secondary">Cancel</a> *@
        @Html.ActionLink("Cancel", "Index", "Department", null, new { @class = "btn btn-outline-secondary" })
    </div>
}